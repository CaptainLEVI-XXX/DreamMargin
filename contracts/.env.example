# Never commit a funded key. The real `.env` is ignored.
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# Somnia Shannon testnet.
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_FALLBACK_RPC_URL=https://api.infra.testnet.somnia.network
SHANNON_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SHANNON_EXPLORER_URL=https://shannon-explorer.somnia.network
SOMNIA_VERIFIER_URL=https://shannon-explorer.somnia.network/api

# DreamDEX testnet venue. Market discovery verifies this against each live row.
DREAMDEX_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Deliberately short, testnet-only administration and oracle timings.
GOVERNANCE_DELAY_SECONDS=60
MARKET_EXPIRY_HEADROOM_SECONDS=21600
ORACLE_MIN_AGE_SECONDS=60
ORACLE_UPDATE_INTERVAL_SECONDS=30
ORACLE_STALE_AFTER_SECONDS=600
SERIES_MIN_INTERVAL_SECONDS=3600
