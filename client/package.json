{
  "name": "dreammargin-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "generate:deployment": "node scripts/generate-deployment.mjs && prettier --write src/config/deployment.ts",
    "generate:abis": "node scripts/generate-abis.mjs && prettier --write src/web3/abis",
    "generate": "node scripts/generate-deployment.mjs && node scripts/generate-abis.mjs && prettier --write src/config/deployment.ts src/web3/abis"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.28.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  }
}
